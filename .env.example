# Local academic mode: omit DATABASE_URL to use persistent SQLite under instance/.
# Production/Vercel: set a persistent PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a long random value for every real deployment.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# HTTPS deployments should keep secure cookies enabled.
SESSION_COOKIE_SECURE=1

# Legacy point-forecast display threshold. V18 runtime policy is stored in its artifact.
DECLINE_THRESHOLD=0.08
